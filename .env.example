# Canonical app/MCP origin. HTTPS for production, no trailing slash.
PUBLIC_ORIGIN=http://localhost:3000
# Google SSO: set all four on the worker to enable the private service.
# Generate BETTER_AUTH_SECRET with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BRAIN_OWNER_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional Vercel bridge only: set the same random secret on Vercel and the worker.
BRAIN_BRIDGE_KEY=
# Only Vercel needs this. Worker must have a publicly reachable HTTPS URL.
BRAIN_SERVICE_URL=
# Only the worker needs this. It is never exposed to the browser or Vercel.
JEV_API_KEY=
JEV_MODEL=jev-1.14.0
# Empty retains proposals. After verification enable new,update,promote.
AUTO_ACCEPT=
VAULT_PATH=./data/vault
STATE_PATH=./data/state
SYNC_ENABLED=false
SYNC_INTERVAL_MS=30000
PORT=3000

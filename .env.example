# Canonical frontend origin. HTTPS for production, no trailing slash.
PUBLIC_ORIGIN=http://localhost:3000
# Generate locally with: npm run password
BRAIN_PASSWORD_HASH=
# Required in production; set the same random secret on Vercel and the worker.
BRAIN_BRIDGE_KEY=
# Only Vercel needs this. Worker must have a publicly reachable HTTPS URL.
BRAIN_SERVICE_URL=
# Only the worker needs this. It is never exposed to the browser or Vercel.
JEV_API_KEY=
JEV_MODEL=jev-1.14.0
# Empty retains all new/update proposals. Enable new,update after evaluation.
AUTO_ACCEPT=
VAULT_PATH=./data/vault
STATE_PATH=./data/state
SYNC_ENABLED=false
SYNC_INTERVAL_MS=30000
PORT=3000
